{
  "name": "@coollime/leetcode.challenge.monthly",
  "description": "LeetCode Monthly Challenge",
  "license": "MIT",
  "author": "Cool Lime",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "lint": "oxlint",
    "test": "jest --coverage",
    "validate-ts": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@babel/preset-typescript": "8.0.1",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.4.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "17.4.1",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.5",
    "prettier-package-json": "^2.8.0",
    "typescript": "7.0.2"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/index.ts",
      "!src/public_apis.ts",
      "!src/common/**/*"
    ],
    "coverageDirectory": "coverage",
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    },
    "testEnvironment": "node"
  },
  "lint-staged": {
    "*.{ts,js}": "oxlint --fix",
    "*.{ts,js,json,md}": "prettier --write",
    "package.json": [
      "prettier-package-json --write"
    ]
  }
}
